rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

  function incoming() { return request.resource.data; }
  function existing() { return resource.data; }
  function isSignedIn() { return request.auth != null; }

  function isValidGuest(data) {
    return data.keys().hasAll(['nik', 'name', 'address', 'phone', 'inmate_name', 'relationship', 'purpose', 'status', 'check_in_time'])
      && data.nik is string && data.nik.size() <= 20
      && data.name is string && data.name.size() <= 100
      && data.address is string && data.address.size() <= 500
      && data.phone is string && data.phone.size() <= 20
      && data.inmate_name is string && data.inmate_name.size() <= 100
      && data.relationship is string && data.relationship.size() <= 50
      && data.purpose is string && data.purpose.size() <= 500
      && data.status is string && data.status.size() <= 20
      && data.check_in_time is string && data.check_in_time.size() <= 50
      && (data.photo_url == null || (data.photo_url is string && data.photo_url.size() <= 2000000));
  }
  
  match /guests/{guestId} {
    // Anyone signed in can read (all admins)
    allow read: if true;
    // Anyone can create a guest record (pengunjung tidak perlu login)
    allow create: if isValidGuest(incoming());
    
    allow update: if isValidGuest(incoming()) && (
      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'check_out_time']))
    );
    
    allow delete: if true; // Only signed in can delete
  }
}
}
